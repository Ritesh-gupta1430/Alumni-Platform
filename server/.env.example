PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/alumnetra_dev

JWT_ACCESS_SECRET=dev_access_secret_change_me_in_production
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_in_production
JWT_ACCESS_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

CLIENT_URL=http://localhost:5173

# Email: console | ethereal | smtp
EMAIL_PROVIDER=console
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=REPLACE_ME
SMTP_PASS=REPLACE_ME
SMTP_FROM="AlumNetra <no-reply@alumnetra.local>"

# Storage: local | cloudinary
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=./uploads
CLOUDINARY_CLOUD_NAME=REPLACE_ME
CLOUDINARY_API_KEY=REPLACE_ME
CLOUDINARY_API_SECRET=REPLACE_ME

# Payment: mock | razorpay | stripe
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
STRIPE_SECRET_KEY=REPLACE_ME

OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

SESSION_SECRET=dev_session_secret_change_me
